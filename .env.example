# dev | prod
ENV=dev

# Local Postgres from docker compose (Supabase connection string in prod)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/cold_email

# Auth. AUTH_DISABLED=true is a dev-only bypass and is refused when ENV=prod.
AUTH_DISABLED=true
ALLOWED_EMAIL=you@example.com
# Supabase project URL (JWTs are verified against its JWKS)...
SUPABASE_URL=
# ...or, for projects still on the legacy shared secret, set this instead.
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Gmail OAuth client from Google Cloud (see README: "Connect Gmail")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
FRONTEND_URL=http://localhost:3000
# Encrypts the stored Gmail token. Generate one with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Resume storage: local (dev) | supabase (prod, Phase 4)
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./backend/uploads
