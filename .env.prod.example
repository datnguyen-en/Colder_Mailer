# Production settings. Copy to .env.prod (git-ignored) and fill in.
# Used to run migrations against Supabase and to load AWS SSM in Phase 4.
ENV=prod
ALLOWED_EMAIL=you@gmail.com

# --- Supabase: Project Settings -> API Keys, and the "Connect" button --------
# Project URL, e.g. https://abcdefghij.supabase.co
SUPABASE_URL=
# "Publishable key" (sb_publishable_...). Not secret; the website uses it for login.
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). SECRET: lets the API read/write the resume bucket.
SUPABASE_SECRET_KEY=
STORAGE_BACKEND=supabase
SUPABASE_BUCKET=resumes
# Connect -> "Transaction pooler" URI (port 6543), with [YOUR-PASSWORD] replaced. Used by Lambda.
DATABASE_URL=
# Connect -> "Session pooler" URI (port 5432), with [YOUR-PASSWORD] replaced. Used for migrations.
MIGRATIONS_DATABASE_URL=

# --- Gmail: same Google client as local; prod redirect URI comes in Step 2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Its own key, separate from local dev (generate like in .env.example)
TOKEN_ENCRYPTION_KEY=

# --- Website (Step 3: the Vercel address) ------------------------------------
FRONTEND_URL=
CORS_ORIGINS=
